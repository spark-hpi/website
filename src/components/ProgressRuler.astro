---
// Headless: renders no UI; just drives .toc li.active via IntersectionObserver.
---

<script>
  // Drives .toc li.active based on the heading currently in view.
  const headings = Array.from(
    document.querySelectorAll<HTMLElement>(
      ".prose h1[id], .prose h2[id], .prose h3[id]",
    ),
  );
  if (headings.length > 0) {
    const tocLinks = new Map<string, HTMLElement>();
    document
      .querySelectorAll<HTMLElement>("[data-toc-link]")
      .forEach((el) => tocLinks.set(el.dataset.tocLink!, el));

    // Map every heading id → the id of the chapter-divider that contains it
    // (the most recent chapter-divider in DOM order). Used to keep the chapter
    // TOC entry highlighted while scrolling through that chapter's contents.
    const headingToChapter = new Map<string, string>();
    let runningChapter: string | null = null;
    headings.forEach((h) => {
      if (h.classList.contains("chapter-divider")) runningChapter = h.id;
      if (runningChapter) headingToChapter.set(h.id, runningChapter);
    });

    let activeId: string | null = null;
    let activeChapter: string | null = null;

    function scrollTocInto(el: HTMLElement | null | undefined) {
      if (!el) return;
      const container = el.closest<HTMLElement>(".toc");
      if (!container) return;
      if (container.scrollHeight <= container.clientHeight) return;
      const er = el.getBoundingClientRect();
      const cr = container.getBoundingClientRect();
      const pad = 12;
      if (er.top < cr.top + pad) {
        container.scrollTop += er.top - cr.top - pad;
      } else if (er.bottom > cr.bottom - pad) {
        container.scrollTop += er.bottom - cr.bottom + pad;
      }
    }

    // IDE-style: smooth-scroll the TOC so the active chapter's group sits at
    // the top of the rail (its sticky mono summary then pins there).
    function pinChapterAtTop(chapterLi: HTMLElement | null | undefined) {
      if (!chapterLi) return;
      const container = chapterLi.closest<HTMLElement>(".toc");
      if (!container) return;
      if (container.scrollHeight <= container.clientHeight) return;
      const top =
        chapterLi.getBoundingClientRect().top -
        container.getBoundingClientRect().top +
        container.scrollTop;
      container.scrollTo({ top, behavior: "smooth" });
    }

    function liFor(id: string | null): HTMLElement | null {
      if (!id) return null;
      return tocLinks.get(id)?.closest<HTMLElement>("li") ?? null;
    }

    function setActive(id: string | null) {
      if (activeId === id) return;
      liFor(activeId)?.classList.remove("active");
      activeId = id;
      const activeLi = liFor(id);
      activeLi?.classList.add("active");

      const newChapter = id ? (headingToChapter.get(id) ?? null) : null;
      if (newChapter !== activeChapter) {
        liFor(activeChapter)?.classList.remove("in-chapter");
        activeChapter = newChapter;
        const chapterLi = liFor(activeChapter);
        chapterLi?.classList.add("in-chapter");
        // Auto-expand the active chapter's details and pin it to the top.
        const det = chapterLi?.querySelector<HTMLDetailsElement>("details");
        if (det && !det.open) det.open = true;
        pinChapterAtTop(chapterLi);
      }

      // Robust fallback: ensure every ancestor <details> of the active TOC
      // entry is open (covers chapters whose divider id doesn't match the
      // fast-path chapter lookup for whatever reason).
      let el: HTMLElement | null = activeLi ?? null;
      while (el) {
        const d = el.closest<HTMLDetailsElement>("details");
        if (!d) break;
        if (!d.open) d.open = true;
        el = d.parentElement;
      }

      scrollTocInto(activeLi ?? liFor(activeChapter));
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length > 0) {
          setActive((visible[0].target as HTMLElement).id);
        }
      },
      { rootMargin: "0px 0px -75% 0px", threshold: 0 },
    );
    headings.forEach((h) => observer.observe(h));
  }
</script>
