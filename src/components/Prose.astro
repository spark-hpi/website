---
/**
 * Prose.astro — the <article> wrapper for rendered markdown.
 *
 * WHAT: renders `<article class="prose ...">` around its slot and pulls in
 *   prose.css (all the article typography). The slot holds Astro <Content/>
 *   components produced by render() (plus <ChapterDivider/>s on a workshop page).
 * WHY: both routes used to inline an identical ~150-line copy of the prose CSS;
 *   this component is its single home, and the single place the `prose` class is
 *   applied.
 * PROPS: `variant` — "workshop" (denser headings + chapter dividers) or "subpage".
 * DOM contract: the `prose` class is what ProgressRuler's scroll-spy and the
 *   link-preview script scope their queries to (`.prose h1[id]`, etc.).
 */
import "../styles/prose.css";

interface Props {
  variant?: "workshop" | "subpage";
}
const { variant = "workshop" } = Astro.props;
---

<article class:list={["prose", variant]}><slot /></article>
