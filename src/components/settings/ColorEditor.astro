---
/**
 * ColorEditor.astro — the per-theme colour overrides section of the settings panel.
 *
 * Responsibility: let the visitor override --bg/--fg/--link for the active theme
 *   (light or dark) and persist them to localStorage under "spark-colors-<theme>".
 *   The pre-paint script in Base.astro reads the same keys to apply colours
 *   before first paint.
 * Used by: settings/SettingsPanel.astro (rendered inside the shared dialog).
 * Listens: "spark:settings-open" (dispatched by SettingsPanel) → refill the inputs
 *   from the saved/computed colours. Also watches data-theme + the OS colour
 *   scheme so a theme switch re-applies that theme's saved overrides.
 * STORAGE CONTRACT: keys "spark-theme" and "spark-colors-<theme>" are shared,
 *   by literal string, with the is:inline pre-paint script in Base.astro — an
 *   inline script cannot import constants, so both sides must agree by hand.
 * DOM contract: lives inside #theme-edit-panel; styled there (is:global).
 */
---

<div class="row">
  <label for="clr-bg-text">Background</label>
  <input id="clr-bg-swatch" data-var="bg" type="color" />
  <input
    id="clr-bg-text"
    data-var="bg"
    type="text"
    spellcheck="false"
    maxlength="7"
    placeholder="#9EC8FF"
  />
</div>
<div class="row">
  <label for="clr-fg-text">Foreground</label>
  <input id="clr-fg-swatch" data-var="fg" type="color" />
  <input
    id="clr-fg-text"
    data-var="fg"
    type="text"
    spellcheck="false"
    maxlength="7"
    placeholder="#0E003B"
  />
</div>
<div class="row">
  <label for="clr-link-text">Link</label>
  <input id="clr-link-swatch" data-var="link" type="color" />
  <input
    id="clr-link-text"
    data-var="link"
    type="text"
    spellcheck="false"
    maxlength="7"
    placeholder="#240195"
  />
</div>
<div class="actions">
  <button id="clr-reset" type="button">Reset this theme</button>
  <span class="hint">Saved to this browser</span>
</div>

<script>
  const VARS = ["bg", "fg", "link"] as const;
  type Var = (typeof VARS)[number];
  type Theme = "light" | "dark";

  const root = document.documentElement;
  const panel = document.getElementById("theme-edit-panel") as HTMLDivElement;
  const resetBtn = document.getElementById("clr-reset") as HTMLButtonElement;
  const themeLabel = document.getElementById(
    "clr-theme-label",
  ) as HTMLSpanElement;

  const HEX = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i;

  function activeTheme(): Theme {
    const d = root.dataset.theme;
    if (d === "light" || d === "dark") return d;
    return matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  }
  function key(t: Theme) {
    return `spark-colors-${t}`;
  }
  function readOverrides(t: Theme): Partial<Record<Var, string>> {
    try {
      const r = localStorage.getItem(key(t));
      return r ? JSON.parse(r) : {};
    } catch {
      return {};
    }
  }
  function writeOverrides(t: Theme, v: Partial<Record<Var, string>>) {
    try {
      if (Object.keys(v).length === 0) localStorage.removeItem(key(t));
      else localStorage.setItem(key(t), JSON.stringify(v));
    } catch {}
  }
  function applyOverrides(v: Partial<Record<Var, string>>) {
    for (const k of VARS) {
      const val = v[k];
      if (val) root.style.setProperty(`--${k}`, val);
      else root.style.removeProperty(`--${k}`);
    }
  }
  function currentComputed(k: Var): string {
    const s = getComputedStyle(root).getPropertyValue(`--${k}`).trim();
    return normalizeToHex(s);
  }
  function normalizeToHex(input: string): string {
    if (!input) return "#000000";
    if (HEX.test(input)) {
      if (input.length === 4) {
        return (
          "#" +
          input
            .slice(1)
            .split("")
            .map((c) => c + c)
            .join("")
        ).toLowerCase();
      }
      return input.toLowerCase();
    }
    const m = input.match(/rgba?\(([^)]+)\)/i);
    if (m) {
      const [r, g, b] = m[1].split(/[,\s/]+/).map(Number);
      const h = (n: number) =>
        Math.max(0, Math.min(255, Math.round(n)))
          .toString(16)
          .padStart(2, "0");
      return `#${h(r)}${h(g)}${h(b)}`;
    }
    return "#000000";
  }

  function populateInputs() {
    const t = activeTheme();
    themeLabel.textContent = t;
    const saved = readOverrides(t);
    for (const k of VARS) {
      const swatch = document.getElementById(
        `clr-${k}-swatch`,
      ) as HTMLInputElement;
      const text = document.getElementById(`clr-${k}-text`) as HTMLInputElement;
      const value = saved[k] ?? currentComputed(k);
      swatch.value = value;
      text.value = value;
      text.classList.remove("invalid");
    }
  }

  function setVar(k: Var, value: string) {
    const t = activeTheme();
    const saved = readOverrides(t);
    saved[k] = value;
    writeOverrides(t, saved);
    applyOverrides(saved);
  }

  // Inputs
  for (const k of VARS) {
    const swatch = document.getElementById(
      `clr-${k}-swatch`,
    ) as HTMLInputElement;
    const text = document.getElementById(`clr-${k}-text`) as HTMLInputElement;

    swatch.addEventListener("input", () => {
      text.value = swatch.value;
      text.classList.remove("invalid");
      setVar(k, swatch.value);
    });
    text.addEventListener("input", () => {
      const v = text.value.trim();
      if (HEX.test(v)) {
        text.classList.remove("invalid");
        const norm = normalizeToHex(v);
        swatch.value = norm;
        setVar(k, norm);
      } else {
        text.classList.add("invalid");
      }
    });
  }

  // SettingsPanel tells us when it opens so we can refill the inputs.
  document.addEventListener("spark:settings-open", populateInputs);

  // Reset current theme
  resetBtn.addEventListener("click", () => {
    const t = activeTheme();
    writeOverrides(t, {});
    applyOverrides({});
    populateInputs();
  });

  // React to theme changes from the theme toggle (data-theme attr flips) —
  // re-apply the correct override set for the newly active theme.
  new MutationObserver(() => {
    applyOverrides(readOverrides(activeTheme()));
    if (!panel.hidden) populateInputs();
  }).observe(root, { attributes: true, attributeFilter: ["data-theme"] });

  // React to OS theme change when mode is "system"
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    if (root.dataset.theme) return; // explicit theme wins
    applyOverrides(readOverrides(activeTheme()));
    if (!panel.hidden) populateInputs();
  });
</script>
