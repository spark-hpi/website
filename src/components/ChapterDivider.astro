---
/**
 * ChapterDivider.astro — the labelled separator between stacked chapters.
 *
 * WHAT: the `<h2 class="chapter-divider" id={slug}>` that sits between each
 *   chapter's rendered <Content/> on a workshop page.
 * WHY: a workshop page stacks every chapter's markdown; this is the visual + TOC
 *   boundary between them. It replaces the divider heading the old pipeline
 *   injected into the mdast tree.
 * PROPS: `title` (chapter display title) and `id` (its slug — MUST equal
 *   node.slug = slugify(displayTitle)).
 * DOM contract (do not change without updating both): `class="chapter-divider"`
 *   is how TocRail groups the TOC and how ScrollSpy maps headings to chapters;
 *   `id` is the anchor target for `/workshop#chapter` links + their preview cards.
 *   Styling lives in prose.css (`.prose.workshop h2.chapter-divider`).
 */
interface Props {
  title: string;
  id: string;
}
const { title, id } = Astro.props;
---

<h2 class="chapter-divider" id={id}>{title}</h2>
