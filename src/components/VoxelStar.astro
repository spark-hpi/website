---
---
<div class="voxel-star" data-voxel-star aria-hidden="true">
  <canvas class="voxel-canvas"></canvas>
  <span class="voxel-star-fallback"></span>
</div>

<style>
  @import "./voxel/voxel-star.css";
</style>

<script>
  const VOXEL_ENABLED = true;

  function bootVoxel() {
    if (!VOXEL_ENABLED) return;
    const host = document.querySelector<HTMLElement>("[data-voxel-star]");
    if (!host) return;
    const canvas = host.querySelector<HTMLCanvasElement>("canvas.voxel-canvas");
    if (!canvas) return;

    try {
      if (localStorage.getItem("spark-voxel") === "off") return;
      if (new URLSearchParams(location.search).get("voxel") === "off") return;
    } catch {}

    try {
      const gl = canvas.getContext("webgl2") || canvas.getContext("webgl");
      if (!gl) return;
    } catch {
      return;
    }

    import("./voxel/index").then(({ init }) => {
      const handle = init(canvas, {});
      host.dataset.ready = "true";
      window.addEventListener("pagehide", () => handle.dispose(), { once: true });
    });
  }

  if ("requestIdleCallback" in window) {
    (window as unknown as { requestIdleCallback: (cb: () => void) => void })
      .requestIdleCallback(bootVoxel);
  } else {
    setTimeout(bootVoxel, 200);
  }
</script>
