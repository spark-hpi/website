---
import Base from "../../layouts/Base.astro";
import BackLink from "../../components/BackLink.astro";
import WorkshopHero from "../../components/WorkshopHero.astro";
import TocRail from "../../components/TocRail.astro";
import ScrollSpy from "../../components/ScrollSpy.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ChapterDivider from "../../components/ChapterDivider.astro";
import Prose from "../../components/Prose.astro";
import { getCollection, render } from "astro:content";
import { loadContent } from "../../lib/load-content";
import { buildWorkshopToc } from "../../lib/toc";
import {
  collectLinkedPages,
  integrateLinkedIntoToc,
  splitGlossary,
} from "../../lib/links";
import { countWords } from "../../lib/word-count";

export async function getStaticPaths() {
  const { hierarchy } = loadContent();
  return hierarchy.workshops.map((w) => ({
    params: { workshop: w.slug },
    props: { workshopFilename: w.filename },
  }));
}

const { workshopFilename } = Astro.props as { workshopFilename: string };
const { hierarchy } = loadContent();
const workshop = hierarchy.byFilename.get(workshopFilename)!;
const title = workshop.displayTitle;

// Map each hierarchy Node to its renderable collection entry (id === filename).
const entries = await getCollection("docs");
const entryById = new Map(entries.map((e) => [e.id, e]));

// Render the workshop's own body, then each chapter (depth-1 child) separately —
// they stack on the page with a ChapterDivider between them.
const { Content: WorkshopBody, headings: ownHeadings } = await render(
  entryById.get(workshop.filename)!,
);
const chapters = await Promise.all(
  workshop.children.map(async (node) => {
    const { Content, headings } = await render(entryById.get(node.filename)!);
    return { node, Content, headings };
  }),
);

// TOC: own headings + (divider + chapter headings) per chapter, then merge in
// wiki-linked pages under their referencing chapter; split out the glossary.
const baseToc = buildWorkshopToc(
  ownHeadings,
  chapters.map((c) => ({
    title: c.node.displayTitle,
    slug: c.node.slug,
    headings: c.headings,
  })),
);
const exclude = new Set<string>([
  workshop.filename,
  ...workshop.children.map((c) => c.filename),
]);
const linked = collectLinkedPages(
  [workshop.rawContent, ...workshop.children.map((c) => c.rawContent)],
  exclude,
  hierarchy,
);
const { glossary, regular } = splitGlossary(linked);
const toc = integrateLinkedIntoToc(baseToc, regular);

const pageCount = 1 + workshop.children.length;
const wordCount = [workshop, ...workshop.children].reduce(
  (n, p) => n + countWords(p.rawContent),
  0,
);
---

<Base title={`${title} — Spark`}>
  <section class="ws-page">
    <BackLink href="/" label="Workshops" />
    <WorkshopHero
      title={title}
      authors={workshop.authors}
      date={workshop.date}
      pageCount={pageCount}
      wordCount={wordCount}
      cover={workshop.cover}
    />
    <div class="ws-body">
      <TocRail items={toc} glossary={glossary} />
      <Prose variant="workshop">
        <WorkshopBody />
        {
          chapters.map((ch) => {
            const Body = ch.Content;
            return (
              <>
                <ChapterDivider title={ch.node.displayTitle} id={ch.node.slug} />
                <Body />
              </>
            );
          })
        }
      </Prose>
    </div>
  </section>
  <ScrollSpy items={toc} />
  <SiteFooter />
</Base>

<style>
  .ws-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 16px;
  }
  @media (min-width: 640px) {
    .ws-page {
      padding: 32px;
    }
  }
  .ws-body {
    display: grid;
    grid-template-columns: 1fr;
    margin-top: 48px;
  }
  @media (min-width: 1024px) {
    .ws-body {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 64px;
    }
  }
</style>
